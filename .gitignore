ReliefKit/.build/
.swiftpm/

# OpenCV, built from source (~93 MB of binaries across three slices).
#
# Not committed: it is a build artifact with an exact, documented recipe in
# ReliefKit/Frameworks/BUILD_OPENCV.md. Committing it would put ~93 MB of
# binaries into every clone forever.
ReliefKit/Frameworks/opencv2.xcframework/
